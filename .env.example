# Palworld REST API. Keep the API on a trusted network.
API_ROOT=http://127.0.0.1:8212
API_PASSWORD=replace-me

# true: pages are anonymously readable. false: a viewer or admin login is required.
PUBLIC_READ=false
# Optional shared read-only login. Ignored when empty.
PUBLIC_PASSWORD=
ADMIN_PASSWORD=replace-with-a-long-password

DATA_PATH=data
# Optional. Defaults to main.webp beside the SQLite database when that file exists.
MAP_IMAGE_PATH=
LISTEN_ADDRESS=:8080
POLL_INTERVAL=15s
HISTORY_RETENTION=720h

# Optional world actor snapshots. The /game-data endpoint must be enabled on the server.
GAME_DATA_ENABLED=false
GAME_DATA_POLL_INTERVAL=1m

# Enable when Pal-pal itself is served over HTTPS.
SECURE_COOKIES=false
